[Unit]
Description=x-ui remote configuration Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xui-remote
Group=xui-remote
ExecStart=/usr/local/bin/xui-remote -config /etc/xui-remote/config.yaml
Restart=always
RestartSec=5

# The config holds an admin API token, which is full control of the panel, so
# the service sees as little of the host as it can while still writing state.
StateDirectory=xui-remote
Environment=HOME=/var/lib/xui-remote
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
